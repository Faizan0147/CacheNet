<mxfile host="drawio"><diagram name="CacheNet deployment"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="CacheNet deployment: three hosts on one Wi-Fi LAN" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="780" height="40" as="geometry"/></mxCell><mxCell id="ap" value="&lt;b&gt;Wi-Fi router / access point&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;192.168.1.1 (default gateway)&lt;br&gt;2.4 GHz · 802.11n · 72.2 Mbps&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F2F4F7;strokeColor=#94A3B8;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="290" y="60" width="240" height="80" as="geometry"/></mxCell><mxCell id="lan" value="LAN 192.168.1.0/24 (subnet mask 255.255.255.0)" style="swimlane;startSize=30;html=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontColor=#0F172A;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="780" height="200" as="geometry"/></mxCell><mxCell id="h3" value="&lt;b&gt;H3 · Client&lt;/b&gt;&lt;br&gt;192.168.1.11&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;client.py · ui.py · bench.py&lt;br&gt;port: ephemeral&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EFF6FF;strokeColor=#2563EB;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontColor=#0F172A;" vertex="1" parent="lan"><mxGeometry x="20" y="60" width="200" height="100" as="geometry"/></mxCell><mxCell id="h2" value="&lt;b&gt;H2 · Caching proxy&lt;/b&gt;&lt;br&gt;192.168.1.63&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;proxy.py · cache with TTL&lt;br&gt;listens on TCP 9090&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EFF6FF;strokeColor=#2563EB;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontColor=#0F172A;" vertex="1" parent="lan"><mxGeometry x="290" y="60" width="200" height="100" as="geometry"/></mxCell><mxCell id="h1" value="&lt;b&gt;H1 · Origin server&lt;/b&gt;&lt;br&gt;192.168.1.103&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;server.py · www/ objects&lt;br&gt;listens on TCP 8080&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EFF6FF;strokeColor=#2563EB;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontColor=#0F172A;" vertex="1" parent="lan"><mxGeometry x="560" y="60" width="200" height="100" as="geometry"/></mxCell><mxCell id="w3" style="endArrow=none;html=1;dashed=1;strokeColor=#94A3B8;strokeWidth=1.5;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="ap" target="h3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="w2" style="endArrow=none;html=1;dashed=1;strokeColor=#94A3B8;strokeWidth=1.5;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="ap" target="h2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="w1" style="endArrow=none;html=1;dashed=1;strokeColor=#94A3B8;strokeWidth=1.5;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="ap" target="h1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="TCP :9090" style="endArrow=block;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=default;defaultLabelBackgroundColor=page;verticalAlign=bottom;labelPlacement=auto;" edge="1" parent="lan" source="h3" target="h2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="TCP :8080" style="endArrow=block;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=default;defaultLabelBackgroundColor=page;verticalAlign=bottom;labelPlacement=auto;" edge="1" parent="lan" source="h2" target="h1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="Dashed line = Wi-Fi link to the access point. Arrow = CNTP/1.0 request path over TCP (responses return the same way). The proxy contacts H1 only on a cache miss or expiry." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="780" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
